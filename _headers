# Static hosting config (issue 10.12).
#
# Read as-is by Netlify and Cloudflare Pages, which both support this `_headers`
# format. Apache/nginx/Vercel equivalents are listed in docs/audit.md §6. This
# file cannot be verified by a host in `npm test`, so `scripts/check-pages.mjs`
# asserts the three security headers and the cache policy are still declared
# here — a deleted line fails the gate instead of rotting quietly.
#
# Compression is not a header: both hosts gzip/brotli text automatically. On a
# hand-rolled server enable gzip for .js, .css, .svg and .md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML is the entry point and carries no content hash: always revalidate.
/*.html
  Cache-Control: no-cache

# Stable-path assets. Their names do not change, so a long max-age is safe; add
# a ?v= query string when a file's content is replaced in place.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=31536000, immutable

# Content-Security-Policy is deliberately not enabled yet: no inline event
# handler is left (issue 10.4 phase 1), but 32 inline `<script>` blocks — 16
# import maps and 16 bootstraps — still need 'unsafe-inline'. Once those are
# external, uncomment this block and the host serves a policy that matches the
# app:
#
# /*
#   Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; connect-src 'self'
